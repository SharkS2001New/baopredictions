# Compression, caching, and security headers for static + HTML delivery.
<IfModule mod_deflate.c>
  # Do not gzip sitemap.xml — some crawlers mishandle compressed sitemaps.
  SetEnvIfNoCase Request_URI "\.xml$" no-gzip dont-vary
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType application/font-woff2 "access plus 365 days"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Dynamic tip HTML (front controller) — never long-cache in the browser.
  Header set Cache-Control "no-store"
  <FilesMatch "\.(css|js|svg|png|jpe?g|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
  # Sitemap + robots must be cacheable/fetchable by Googlebot (override no-store).
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
    Header unset Expires
  </FilesMatch>
  <Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=UTF-8"
  </Files>
  Header unset ETag
</IfModule>
FileETag None

RewriteEngine On
RewriteBase /

# Canonical host: https://www.baopredictions.com (apex → www)
RewriteCond %{HTTP_HOST} ^baopredictions\.com$ [NC]
RewriteRule ^ https://www.baopredictions.com%{REQUEST_URI} [R=301,L]

# Dynamic sitemap (do not serve a stale static file)
RewriteRule ^sitemap\.xml$ index.php [QSA,L]

# Strip trailing slash (except root) — one canonical URL per page
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# Custom 404
ErrorDocument 404 /index.php

# Allow clean URLs without .php (only if .php file exists in public)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [NC,L]

# Front controller: route other requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "\.(htaccess|htpasswd|env|config\.php|private)$">
    Require all denied
</FilesMatch>
