# Bao Predictions — copy to .env for local only (never commit secrets)
#
# Local: keep APP_URL / BAO_API_BASE on 127.0.0.1 (or your php -S port).
# Production (k3s): DB_* and APP_URL come from Helm values / baopredictions-env.

APP_ENV=local
APP_NAME="Bao Predictions"
APP_URL=http://127.0.0.1:8081

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pitchnewdb
DB_USERNAME=
DB_PASSWORD=

BAO_API_BASE=http://127.0.0.1:8081

# Shared pitchpredictions API — blogs (website=bao) + optional ACCESS_TOKEN
PITCH_API_URL=https://api.pitchpredictions.com
ACCESS_TOKEN=

# Exactly 24 characters — MUST match admin + other frontends (blog/footer clear + live save)
BLOG_CACHE_CLEAR_KEY=

# Contact form inbox (public brand address — keep @baopredictions.com)
CONTACT_TO_EMAIL=hello@baopredictions.com
MAIL_FROM_ADDRESS=noreply@baopredictions.com
MAIL_FROM_NAME="Bao Predictions"
# Optional SMTP (recommended in production; falls back to PHP mail() if MAIL_HOST is empty)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# —— Same Redis as pitchpredictionsbackend / pitchpredk3ssetup ——
# k3s: Service redis | Secret redis-auth (key redis-password)
# Helm chart sets CACHE_DRIVER + REDIS_* automatically when redis.enabled=true
CACHE_DRIVER=file
CACHE_PREFIX=pitch_predictions_cache_
REDIS_PREFIX=pitch_predictions_database_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# Cloudflare Image Resizing (zone must have Image Resizing enabled).
# When on, crest URLs are rewritten through /cdn-cgi/image/… for small WebP/AVIF.
BAO_CF_IMAGE_RESIZE=0
BAO_CF_IMAGE_ZONE=https://www.baopredictions.com
# Optional: Cloudflare Images delivery URL for OG (after upload)
# BAO_OG_IMAGE=https://imagedelivery.net/<account>/<image-id>/public
