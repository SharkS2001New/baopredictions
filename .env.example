# Bao Predictions — copy to .env for local only (never commit secrets)
#
# Local: keep APP_URL / BAO_API_BASE on 127.0.0.1 (or your php -S port).
# Production (k3s): Helm sets APP_URL=https://www.baopredictions.com — do not put
# production URLs in this file; the image does not ship .env.

APP_ENV=local
APP_NAME="Bao Predictions"
APP_URL=http://127.0.0.1:8081

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pitchnewdb
DB_USERNAME=
DB_PASSWORD=

BAO_API_BASE=http://127.0.0.1:8081

# —— Same Redis as pitchpredictionsbackend / pitchpredk3ssetup ——
# k3s: Service redis | Secret redis-auth (key redis-password)
# Helm chart sets CACHE_DRIVER + REDIS_* automatically when redis.enabled=true
# —— Cache TTLs (Pitch FixtureApiHelpers bands) ——
# today → 10m | tomorrow → 1h | past → 12h | weekend → 5h | jackpot → 10m | stats → 5m
# live → no cache unless CACHE_TTL_LIVE is set (pitch uses ~60s)
CACHE_DRIVER=redis
# CACHE_TTL_TODAY=600
# CACHE_TTL_TOMORROW=3600
# CACHE_TTL_PAST=43200
# CACHE_TTL_WEEKEND=18000
# CACHE_TTL_JACKPOT=600
# CACHE_TTL_STATS=300
# CACHE_TTL_LIVE=0
CACHE_PREFIX=pitch_predictions_cache_
REDIS_PREFIX=pitch_predictions_database_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# Optional: REDIS_URL=redis://:password@redis:6379/1

# Set BAO_LOG_DEBUG=1 to emit debug-level bao_log lines outside APP_ENV=local
# BAO_LOG_DEBUG=0
